# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (at any level)
**/venv/
**/env/
**/ENV/
**/.venv

# IDE (at any level)
**/.vscode/
**/.idea/
*.swp
*.swo

# OS files (at any level)
**/.DS_Store
**/Thumbs.db

# Environment variables (at any level)
**/.env

# Distribution / packaging (at any level)
**/dist/
**/build/
*.egg-info/

# Testing (at any level)
**/.pytest_cache/
**/.coverage
**/htmlcov/

# Logs (at any level)
**/*.log
